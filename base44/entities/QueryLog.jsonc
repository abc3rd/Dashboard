{
  "name": "QueryLog",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "User's original question"
    },
    "answer": {
      "type": "string",
      "description": "AI model's response"
    },
    "chosen_model": {
      "type": "string",
      "description": "ID of the model that was selected"
    },
    "confidence": {
      "type": "number",
      "description": "Response confidence score (0-1)"
    },
    "latency_ms": {
      "type": "number",
      "description": "Response time in milliseconds"
    },
    "session_id": {
      "type": "string",
      "description": "Anonymous client session identifier used for free-tier rate limiting when no user is logged in"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-applied tags for organizing and finding past queries (private to the owner)"
    }
  },
  "required": [
    "prompt",
    "answer",
    "chosen_model"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}